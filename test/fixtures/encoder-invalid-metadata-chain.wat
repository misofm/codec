(module
  (import "codec" "write" (func $write (param i64 i32 i32) (result i32)))
  (import "codec" "seek" (func $seek (param i64) (result i32)))
  (memory (export "memory") 256 256)
  ;; A valid empty 8 kHz/mono/PCM16 STREAMINFO that declares another metadata
  ;; block, but the backend never emits that block.
  (data (i32.const 1024)
    "\66\4c\61\43\00\00\00\22\10\00\10\00\00\00\00\00\00\00\01\f4\00\f0\00\00\00\00\d4\1d\8c\d9\8f\00\b2\04\e9\80\09\98\ec\f8\42\7e")
  (func $malloc (param i32) (result i32) (i32.const 2048))
  (func $free (param i32))
  (func $new (param i32 i32 i32 i32 i32) (result i32) (i32.const 256))
  (func $init (param i32) (result i32)
    (drop (call $write (i64.const 0) (i32.const 1024) (i32.const 42)))
    (i32.const 0))
  (func $process (param i32 i32 i32) (result i32) (i32.const 1))
  (func $finish (param i32) (result i32) (i32.const 1))
  (func $state (param i32) (result i32) (i32.const 0))
  (func $delete (param i32))
  (export "malloc" (func $malloc))
