{
  "name": "@misofm/codec",
  "version": "0.1.1",
  "description": "Effect-based audio codec primitives backed by pinned libFLAC WebAssembly",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/codec.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.2 <1.5",
    "node": ">=22.23.2 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./wasm/flac-encoder.wasm": "./wasm/flac-encoder.wasm",
    "./wasm/flac-decoder.wasm": "./wasm/flac-decoder.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm/*.wasm",
    "wasm/*.manifest.json",
    "README.md",
    "docs/*.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor/licenses"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "bun run scripts/build-wasm.ts --verify && bun run scripts/build-decoder-wasm.ts --verify",
    "build:wasm:update": "bun run scripts/build-wasm.ts --update && bun run scripts/build-decoder-wasm.ts --update",
    "build:wasm:verify": "bun run scripts/build-wasm.ts --verify && bun run scripts/build-decoder-wasm.ts --verify",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.{ts,mjs}\" \"consumer/**/*.ts\" \"benchmark/*.ts\" \"benchmark/*.md\" \"benchmark/tsconfig.json\" \"docs/*.md\" \"*.md\" \".github/**/*.md\" \".github/**/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.{ts,mjs}\" \"consumer/**/*.ts\" \"benchmark/*.ts\" \"benchmark/*.md\" \"benchmark/tsconfig.json\" \"docs/*.md\" \"*.md\" \".github/**/*.md\" \".github/**/*.yml\" \"*.json\"",
    "pack:check": "node scripts/pack-check.mjs",
    "test": "bun test",
    "test:integration": "if [ -z \"$CODEC_NATIVE_FLAC\" ]; then echo 'CODEC_NATIVE_FLAC must name the pinned native flac binary' >&2; exit 1; fi; bun test test/*-native-integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p benchmark/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112 || 4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/node": "22.20.2",
    "effect": "4.0.0-rc.115",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
